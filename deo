<!DOCTYPE html>
<html lang="te">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TGPSC Deputy Educational Officer Study Material | Paper-II</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  
  <!-- Razorpay Checkout లైబ్రరీ -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style>
    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --accent: #16a34a;
      --accent-hover: #15803d;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --text-muted: #475569;
      --border: #e2e8f0;
      --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', 'Noto Sans Telugu', sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding-bottom: 50px;
    }

    header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: white;
      padding: 28px 16px;
      text-align: center;
      border-bottom: 4px solid var(--primary);
    }

    header h1 {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: #38bdf8;
    }

    header .sub-tag {
      font-size: 0.95rem;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 12px;
      display: inline-block;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 2px 10px;
      border-radius: 4px;
    }

    header p.intro-desc {
      font-size: 0.88rem;
      color: #cbd5e1;
      max-width: 720px;
      margin: 0 auto;
      line-height: 1.6;
      text-align: justify;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 16px;
    }

    .bundle-card {
      background: linear-gradient(to bottom right, #eff6ff, #dbeafe);
      border: 2px solid var(--primary);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background-color: #ef4444;
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      text-transform: uppercase;
    }

    .bundle-card h2 {
      font-size: 1.25rem;
      color: var(--primary-dark);
      margin-bottom: 8px;
    }

    .bundle-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .price-tag {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 14px;
    }

    .price-tag span {
      font-size: 0.9rem;
      font-weight: normal;
      color: var(--text-muted);
      text-decoration: line-through;
      margin-left: 8px;
    }

    .btn {
      display: inline-block;
      text-align: center;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-primary {
      width: 100%;
      padding: 12px 20px;
      font-size: 1rem;
      background-color: var(--accent);
      color: white;
    }

    .btn-primary:active {
      background-color: var(--accent-hover);
      transform: scale(0.98);
    }

    .btn-buy {
      background-color: var(--primary);
      color: white;
      padding: 8px 18px;
      font-size: 0.9rem;
      border-radius: 6px;
    }

    .btn-buy:active {
      background-color: var(--primary-dark);
      transform: scale(0.96);
    }

    .section-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    @media (min-width: 600px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow);
    }

    .card h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 6px;
      line-height: 1.4;
    }

    .card p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 12px;
      flex-grow: 1;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    .card-price {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
    }

    .loader {
      text-align: center;
      padding: 40px 0;
      color: var(--text-muted);
      font-size: 1rem;
    }

    #overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.7);
      color: #fff;
      z-index: 9999;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      text-align: center;
      padding: 20px;
    }
    #overlay p {
      margin-top: 12px;
      font-size: 1.1rem;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div id="overlay">
    <div style="font-size: 2rem;">⏳</div>
    <p id="overlay-msg">దయచేసి వేచి ఉండండి...</p>
  </div>

  <header>
    <h1>TGPSC Deputy Educational Officer స్టడీ మెటీరియల్</h1>
    <div class="sub-tag">Deputy Educational Officer | Paper-II Education</div>
    <p class="intro-desc">
      పరీక్షకు సంబంధించిన సమగ్ర స్టడీ మెటీరియల్ చాప్టర్ల వారీగా రూపొందించబడింది. ప్రతి చాప్టర్‌కు ముందుగా పరిచయ (Introduction) మెటీరియల్, ఆ తర్వాత సంబంధిత అంశాలపై 200 ప్రామాణిక మల్టిపుల్ ఛాయిస్ ప్రశ్నలు (MCQs), సరైన సమాధానాలతో సహా అందించబడింది. క్విక్ రివిజన్ కోసం ఇది మీకు ఎంతగానో ఉపయోగపడుతుంది.
    </p>
  </header>

  <div class="container">
    
    <div id="bundle-container"></div>

    <div class="section-title">
      <span>అధ్యాయాల వారీగా మెటీరియల్ (PDF + 200 MCQs)</span>
    </div>

    <div id="loading" class="loader">మెటీరియల్ జాబితా లోడ్ అవుతోంది...</div>
    <div class="grid" id="chapters-grid"></div>

  </div>

  <script>
    const API_BASE = "https://study.smartstudyhub.workers.dev";
    
    // మీ అసలైన లైవ్ Razorpay Key ID
    const RAZORPAY_KEY_ID = "rzp_live_T18sE5oDk1k8ey";

    function showStatus(msg) {
      const overlay = document.getElementById("overlay");
      document.getElementById("overlay-msg").innerText = msg;
      overlay.style.display = "flex";
    }

    function hideStatus() {
      document.getElementById("overlay").style.display = "none";
    }

    async function loadProducts() {
      const loader = document.getElementById("loading");
      const bundleContainer = document.getElementById("bundle-container");
      const chaptersGrid = document.getElementById("chapters-grid");

      try {
        const res = await fetch(`${API_BASE}/api/products`);
        const data = await res.json();

        if (!data.success || !data.products) {
          loader.innerHTML = "వివరాలు అందుబాటులో లేవు.";
          return;
        }

        loader.style.display = "none";
        bundleContainer.innerHTML = "";
        chaptersGrid.innerHTML = "";

        data.products.forEach(p => {
          if (p.product_type === "bundle") {
            bundleContainer.innerHTML = `
              <div class="bundle-card">
                <span class="badge">Super Saver Offer</span>
                <h2>${p.title}</h2>
                <p>${p.description}</p>
                <div class="price-tag">₹${p.price} <span>₹135</span></div>
                <button class="btn btn-primary" onclick="initiatePurchase(${p.id}, '${p.title.replace(/'/g, "\\'")}', ${p.price})">Buy Complete Pack (₹${p.price})</button>
              </div>
            `;
          } else {
            const card = document.createElement("div");
            card.className = "card";
            card.innerHTML = `
              <div>
                <h3>${p.title}</h3>
                <p>${p.description}</p>
              </div>
              <div class="card-footer">
                <div class="card-price">₹${p.price}</div>
                <button class="btn btn-buy" onclick="initiatePurchase(${p.id}, '${p.title.replace(/'/g, "\\'")}', ${p.price})">Buy</button>
              </div>
            `;
            chaptersGrid.appendChild(card);
          }
        });

      } catch (err) {
        loader.innerHTML = "లోడ్ చేయడంలో సమస్య ఏర్పడింది. దయచేసి మళ్లీ ప్రయత్నించండి.";
        console.error(err);
      }
    }

    function initiatePurchase(id, title, price) {
      const options = {
        "key": RAZORPAY_KEY_ID,
        "amount": Math.round(price * 100),
        "currency": "INR",
        "name": "Smart Study Hub",
        "description": title,
        "theme": {
          "color": "#0284c7"
        },
        "handler": async function (response) {
          showStatus("చెల్లింపు పూర్తయింది! మీ PDF డౌన్‌లోడ్ సిద్ధం అవుతోంది...");

          try {
            const res = await fetch(`${API_BASE}/api/get-download-url`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId: id })
            });

            const data = await res.json();

            if (data.downloadUrl) {
              showStatus("డౌన్‌లోడ్ ప్రారంభమవుతోంది...");
              setTimeout(() => {
                hideStatus();
                window.location.href = data.downloadUrl;
              }, 1200);
            } else {
              hideStatus();
              alert("డౌన్‌లోడ్ లింక్ పొందడంలో సమస్య: " + (data.error || "తెలియని లోపం"));
            }
          } catch (err) {
            hideStatus();
            alert("కనెక్షన్ ఎర్రర్: " + err.message);
          }
        },
        "modal": {
          "ondismiss": function() {
            hideStatus();
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    }

    loadProducts();
  </script>
</body>
</html>
